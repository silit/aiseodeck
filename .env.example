# Address of the app (no trailing slash)
APP_URL=https://aiseodeck.silitlabs.com
# Long random strings (32+ characters)
SESSION_SECRET=
CRON_SECRET=

# Webflow app (Silit Labs workspace > Apps & Integrations > Develop)
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=

# Upstash Redis (added automatically by Vercel Storage)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Email (Resend, silitlabs.com is verified)
RESEND_API_KEY=
EMAIL_FROM=AI SEO Deck <hello@silitlabs.com>

# AI engines: an engine is used when its key is set
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional: model names and limits
# OPENAI_MODEL=gpt-6-luna
# PERPLEXITY_MODEL=sonar
# GEMINI_MODEL=gemini-3.8-flash
# ENGINES=openai,perplexity,gemini
MAX_DAILY_CALLS=4000

# Payments (Polar, shared Silit Labs organization)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
