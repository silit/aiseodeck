# Address of the app (no trailing slash)
APP_URL=https://aiseodeck.silitlabs.com
# Long random strings (32+ characters)
SESSION_SECRET=
CRON_SECRET=

# Webflow app (Silit Labs workspace > Apps & Integrations > Develop)
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=

# Upstash Redis (added automatically by Vercel Storage)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Set when the database is shared with another app, so keys never mix (e.g. asd:)
KV_PREFIX=

# Email (Resend, silitlabs.com is verified)
RESEND_API_KEY=
EMAIL_FROM=AI SEO Deck <hello@silitlabs.com>
# Who is emailed when a paid service refuses our account (credit ran out, key stopped working); at most once every 6 hours per service
ALERT_EMAIL=info@silitlabs.com

# AI engines: an engine is used when its key is set
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# Google AI Overviews and AI Mode come from DataForSEO (API login and password, not the site password)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional: model names and limits
# OPENAI_MODEL=gpt-6-luna
# Perplexity is kept for a later release and stays off until PERPLEXITY_ENABLED=1 (its Agent API needs paid credits):
# PERPLEXITY_API_KEY=
# PERPLEXITY_ENABLED=1
# PERPLEXITY_MODEL=sonar
# The app switches by itself to the Agent API when Sonar is gone;
# PERPLEXITY_API=agent uses the Agent API now (PERPLEXITY_EFFORT=fast, or PERPLEXITY_AGENT_MODEL)
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_MODEL=claude-haiku-5-5
# XAI_MODEL=grok-4.3
# ENGINES=openai,aio,aimode,gemini,claude,grok
# Cost guard: engine answers per day across all users (1.1 to 1.5 cents each)
MAX_DAILY_CALLS=1500

# Payments (Polar, shared Silit Labs organization)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# POLAR_API_BASE=https://sandbox-api.polar.sh
# BILLING_TEST_EMAILS=
# Free trial days on paid plans (default 7, 0 turns the trial off)
# TRIAL_DAYS=7
# Accounts that get the Agency plan for free (Webflow reviewers always do)
# COMPLIMENTARY_EMAILS=

# AI Visibility Report (the one-time report; no Webflow needed). Visitors read it at silitlabs.com, which passes
# /ai-visibility-report and /check on to /_vr on this app. VR_URL is that public address (default https://silitlabs.com).
# VR_URL=https://silitlabs.com
# The Polar product of the report: one-time price, any name. If unset, the product named "AI Visibility Report"
# (or with metadata app=aiseodeck, kind=report) is used. Without a product the report is "not on sale yet".
# POLAR_REPORT_PRODUCT_ID=
# Price shown on the pages, in cents (default 2900). Keep it the same as the Polar product's price.
# VR_PRICE_CENTS=2900
# Searches in a full report, 3 to 6 (default 5: about 50 answers, about $1 in AI calls). They are the most
# searched of ten found on the home page; the search numbers need DATAFORSEO_LOGIN and DATAFORSEO_PASSWORD.
# VR_TOPICS=5
# Free checks: per visitor a day (default 4) and for everyone a day (default 150)
# VR_FREE_PER_IP=4
# VR_FREE_PER_DAY=150
# Search number lookups a day (default 600, about $8). Past it, checks still work and show no numbers.
# VR_LOOKUPS_PER_DAY=600
# Second lookup, at Google Ads, for the searches the first one has no number for: one request when a check starts,
# 9 cents each (default 40 a day, at most $3.60; 0 turns it off)
# VR_ADS_LOOKUPS_PER_DAY=40
# Opens the full report of a check without payment: /check/{id}?key=... (12+ characters; for your own tests and gifts)
# VR_UNLOCK_KEY=
