{
  "redirects": [
    {
      "source": "/ai-visibility-report",
      "destination": "https://silitlabs.com/ai-visibility-report",
      "permanent": true
    },
    {
      "source": "/ai-visibility-report/:rest*",
      "destination": "https://silitlabs.com/ai-visibility-report/:rest*",
      "permanent": true
    },
    {
      "source": "/check",
      "destination": "https://silitlabs.com/ai-visibility-report",
      "permanent": true
    },
    {
      "source": "/check/:rest*",
      "destination": "https://silitlabs.com/check/:rest*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://silitlabs.com/ai-visibility-report",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/billing/webhook",
      "destination": "/api/billing-webhook"
    },
    {
      "source": "/_vr/ai-visibility-report",
      "destination": "/api/index?path=ai-visibility-report"
    },
    {
      "source": "/_vr/ai-visibility-report/:rest*",
      "destination": "/api/index?path=ai-visibility-report/:rest*"
    },
    {
      "source": "/_vr/check/:rest*",
      "destination": "/api/index?path=check/:rest*"
    },
    {
      "source": "/cron/:job",
      "destination": "/api/index?path=cron/:job"
    },
    {
      "source": "/health",
      "destination": "/api/index?path=health"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/cron/vr",
      "schedule": "*/5 * * * *"
    }
  ]
}
