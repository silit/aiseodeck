# AI Visibility Report: environment of this project (Vercel > Settings > Environment Variables)

# Long random strings (32+ characters), of this project's own
REPORT_SECRET=
CRON_SECRET=

# Upstash Redis: the same database AI SEO Deck uses (Vercel > Storage > the database > Connect Project).
# The checks made before the report moved here are in it.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# The same value as in the AI SEO Deck project. Leave it out if that project has none.
# KV_PREFIX=

# Where visitors read the report (default https://silitlabs.com)
# VR_URL=https://silitlabs.com
# The address of AI SEO Deck, which the report's pages link to (default https://aiseodeck.silitlabs.com)
# AISEODECK_URL=https://aiseodeck.silitlabs.com

# Email (Resend, silitlabs.com is verified)
RESEND_API_KEY=
EMAIL_FROM=AI Visibility Report <hello@silitlabs.com>
# Who is emailed when a paid service refuses our account; at most once every 6 hours per service
ALERT_EMAIL=info@silitlabs.com

# AI engines: an engine is used when its key is set
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# Google AI Overviews, AI Mode and search numbers come from DataForSEO (API login and password)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional: model names, the same as in the AI SEO Deck project if they are set there
# OPENAI_MODEL=
# GEMINI_MODEL=
# ANTHROPIC_MODEL=
# XAI_MODEL=
# Cost guard: engine answers per day. The count is kept in the database, so it is shared with AI SEO Deck.
MAX_DAILY_CALLS=1500

# Payments (Polar, the Silit Labs organization). Token scopes: products:read, checkouts:read, checkouts:write.
POLAR_ACCESS_TOKEN=
# The secret of this project's own webhook endpoint at Polar (events order.paid and order.refunded)
POLAR_WEBHOOK_SECRET=
# The Polar product of the report: one-time price, any name. If unset, the product named "AI Visibility Report"
# (or with metadata app=aiseodeck, kind=report) is used. Without a product the report is "not on sale yet".
# POLAR_REPORT_PRODUCT_ID=
# Price shown on the pages, in cents (default 2900). Keep it the same as the Polar product's price.
# VR_PRICE_CENTS=2900

# Searches in a full report, 3 to 6 (default 5: about 50 answers, about $1 in AI calls)
# VR_TOPICS=5
# Free checks: per visitor a day (default 4) and for everyone a day (default 150)
# VR_FREE_PER_IP=4
# VR_FREE_PER_DAY=150
# Search number lookups a day (default 600, about $8). Past it, checks still work and show no numbers.
# VR_LOOKUPS_PER_DAY=600
# Second lookup, at Google Ads, for the searches the first one has no number for: 9 cents each
# (default 40 a day, at most $3.60; 0 turns it off)
# VR_ADS_LOOKUPS_PER_DAY=40
# Opens the full report of a check without payment: /check/{id}?key=... (12+ characters; for your own tests and gifts)
# VR_UNLOCK_KEY=
